<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <LangVersion>10.0</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftPackageVersion)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\MosaicCRM.Core\BootstrapperAttribute.cs" Link="Common\BootstrapperAttribute.cs" />
        <Compile Include="..\MosaicCRM.Core\DependencyInjection\ExportAttribute.cs" Link="Common\ExportAttribute.cs" />
        <Compile Include="..\MosaicCRM.Core\DependencyInjection\LifetimeType.cs" Link="Common\LifetimeType.cs" />
        <Compile Include="..\MosaicCRM.Core\Extensions\Collections\DictionaryExtensions.cs" Link="Common\DictionaryExtensions.cs" />
        <Compile Include="..\MosaicCRM.Core\Modularity\Abstractions\ICrmModule.cs" Link="Common\ICrmModule.cs" />
        <Compile Include="..\MosaicCRM.Core\Modularity\Abstractions\IDependedTypesProvider.cs" Link="Common\IDependedTypesProvider.cs" />
        <Compile Include="..\MosaicCRM.Core\Modularity\ServiceConfigurationContext.cs" Link="Common\ServiceConfigurationContext.cs" />
        <Compile Include="..\MosaicCRM.Core\Modularity\DependsOnAttribute.cs" Link="Common\DependsOnAttribute.cs" />
        <Compile Include="..\MosaicCrm.Generators.Core\Constants.cs" Link="Constants.cs" />
        <Compile Include="..\MosaicCrm.Generators.Core\IsExternalInit.cs" Link="IsExternalInit.cs" />
    </ItemGroup>
</Project>
